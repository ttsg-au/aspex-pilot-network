# Copy this file to .env and fill in. Never share .env – it holds passwords.

# The public address of this app (used in links inside emails), no trailing slash
BASE_URL=https://pilots.aspex.com.au

# Your login
ADMIN_EMAIL=admin@aspex.com.au
# Either set ADMIN_PASSWORD (plain, as a hosting secret) or ADMIN_PASSWORD_HASH (from npm run set-password)
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# The website form's webhook must include ?key=<this value>. Created by npm run set-password.
WEBHOOK_SECRET=

# REQUIRED on GoDaddy: the managed MySQL database. Without it, records are lost on every restart.
# Copy the values from the app's Database page. Either one connection URL:
DATABASE_URL=
# ...or the separate settings:
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
# Set to true only if the host says the connection requires SSL
MYSQL_SSL=

# Sending email as admin@aspex.com.au – OPTION 1 (recommended): Microsoft Graph over HTTPS.
# Works even where the host blocks email ports (GoDaddy app hosting does). See README.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# OPTION 2: SMTP through Microsoft 365 (only if the host allows port 587)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=admin@aspex.com.au
# With neither option set, the app runs in TEST MODE (emails saved to data/outbox, not sent)
SMTP_PASS=
MAIL_FROM=Kimberly Olsen – Aspex Drone Services <admin@aspex.com.au>
MAIL_REPLY_TO=admin@aspex.com.au

# Warn this many days before a credential expires
EXPIRY_WARN_DAYS=60
